# Copy to .env at the repo root and fill in. Never commit .env.

# OpenRouter (https://openrouter.ai/keys) - backs all three model tiers.
OPENROUTER_API_KEY=sk-or-v1-...

# Admin credential for the LiteLLM proxy. Must start with "sk-".
LITELLM_MASTER_KEY=sk-change-me-to-a-long-random-string

# Langfuse Cloud (https://cloud.langfuse.com -> Project Settings -> API Keys)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
