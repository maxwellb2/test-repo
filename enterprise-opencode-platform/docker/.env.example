# Copy to docker/.env and fill in. docker/.env is git-ignored.
# Only the platform team needs these values; individual developers never see them.

# --- OpenRouter (required) ---------------------------------------------------
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- LiteLLM proxy (required) ------------------------------------------------
# Admin key. Grants full control of the proxy, including key creation.
# Generate with: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-master-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Encrypts provider credentials at rest in Postgres. Rotating this invalidates
# every stored credential, so set it once and keep it.
LITELLM_SALT_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POSTGRES_PASSWORD=change-me

# --- Langfuse observability (required for trace visibility) ------------------
# https://cloud.langfuse.com -> Project Settings -> API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com

# --- OpenTelemetry (optional) ------------------------------------------------
# Only used if you switch litellm-config.yaml to the "otel" callback.
# For Langfuse's OTLP endpoint, the header value is:
#   Authorization=Basic <base64 of "public_key:secret_key">
# OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20xxxxxxxx
